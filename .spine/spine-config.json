{
  "configVersion": 1,
  "project": {
    "name": "lane-1",
    "description": ""
  },
  "paths": {
    "tasksRoot": "spine-tasks"
  },
  "baseBranch": "main",
  "testing": {
    "build": "npm run typecheck",
    "test": "npm test",
    "testWithCoverage": "npm run coverage:check"
  },
  "agents": {
    "worker": {
      "model": "zai/glm-5.3-flash",
      "thinking": "high"
    },
    "reviewer": {
      "model": "google/gemini-2.5-pro",
      "thinking": "high",
      "plan": {
        "model": "google/gemini-2.5-pro",
        "thinking": "medium"
      },
      "code": {
        "model": "google/gemini-2.5-pro",
        "thinking": "high"
      },
      "final": {
        "model": "google/gemini-2.5-pro",
        "thinking": "high"
      }
    },
    "supervisor": {
      "model": "google/gemini-3.5-flash-lite",
      "thinking": "off"
    },
    "activeProfile": "default",
    "profiles": {
      "default": {
        "worker": {
          "model": "zai/glm-5.3-flash",
          "thinking": "high"
        }
      },
      "allegretto": {
        "worker": {
          "model": "kimi-coding/k3",
          "thinking": "high"
        }
      },
      "gemini4": {
        "worker": {
          "model": "google/gemini-4-argon",
          "thinking": "high"
        },
        "reviewerProfile": "review-claude"
      },
      "cursor": {
        "worker": {
          "model": "cursor/auto",
          "thinking": "high"
        }
      },
      "qwen-flash": {
        "worker": {
          "model": "llama.cpp/qwen3.8-flash-next-iq3_s",
          "thinking": "medium"
        }
      },
      "sonnet": {
        "worker": {
          "model": "anthropic/claude-sonnet-5-5",
          "thinking": "high"
        }
      },
      "review-gemini": {
        "reviewer": {
          "model": "google/gemini-2.5-pro",
          "thinking": "high",
          "plan": {
            "model": "google/gemini-2.5-pro",
            "thinking": "medium"
          },
          "code": {
            "model": "google/gemini-2.5-pro",
            "thinking": "high"
          },
          "final": {
            "model": "google/gemini-2.5-pro",
            "thinking": "high"
          }
        }
      },
      "review-claude": {
        "reviewer": {
          "model": "anthropic/claude-sonnet-5-5",
          "thinking": "high",
          "plan": {
            "model": "anthropic/claude-sonnet-5-5",
            "thinking": "medium"
          },
          "code": {
            "model": "anthropic/claude-sonnet-5-5",
            "thinking": "high"
          },
          "final": {
            "model": "anthropic/claude-sonnet-5-5",
            "thinking": "high"
          }
        }
      },
      "anthropic": {
        "worker": {
          "model": "anthropic/claude-opus-5-5",
          "thinking": "high"
        }
      }
    },
    "escalatePolicy": {
      "enabled": true,
      "toProfile": "anthropic"
    },
    "quotaFallbackProfile": "allegretto",
    "reviewerProfile": "review-gemini"
  },
  "lanes": {
    "maxParallel": 2,
    "queueExcess": true,
    "streamWorkerOutputLive": true,
    "stallTimeoutMinutes": 120,
    "stallGraceAfterProgressMinutes": 30,
    "heartbeatIntervalMinutes": 10,
    "checkpointWarningMinutes": 10
  },
  "gates": {
    "requireBeforeIntegrate": true,
    "collectBuildEvidence": true,
    "collectTestEvidence": true
  },
  "review": {
    "requireFinalVerdict": true,
    "maxFinalAttempts": 3
  },
  "handoff": {
    "path": ".spine/handoff.md",
    "autoWriteOn": [
      "session_start"
    ]
  },
  "metrics": {
    "enabled": true,
    "path": ".spine/run-metrics.jsonl"
  },
  "contract": {
    "mode": "required",
    "legacyTaskIdPrefixes": [
      "TP-"
    ]
  },
  "worktreeSetupHook": "scripts/spine-worktree-setup.sh",
  "referenceDocs": [],
  "standards": [],
  "neverLoad": []
}
