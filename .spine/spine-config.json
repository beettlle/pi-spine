{
  "configVersion": 1,
  "project": {
    "name": "lane-1",
    "description": ""
  },
  "paths": {
    "tasksRoot": "spine-tasks"
  },
  "baseBranch": "main",
  "testing": {
    "build": "npm run typecheck",
    "test": "npm test",
    "testWithCoverage": "npm run coverage:check"
  },
  "agents": {
    "worker": {
      "model": "cursor/auto",
      "thinking": "high"
    },
    "reviewer": {
      "model": "cursor/auto",
      "thinking": "medium"
    },
    "supervisor": {
      "model": "inherit",
      "thinking": "off"
    }
  },
  "lanes": {
    "maxParallel": 6,
    "queueExcess": true,
    "stallTimeoutMinutes": 120,
    "stallGraceAfterProgressMinutes": 30,
    "heartbeatIntervalMinutes": 10,
    "checkpointWarningMinutes": 10
  },
  "gates": {
    "requireBeforeIntegrate": true,
    "collectBuildEvidence": true,
    "collectTestEvidence": true
  },
  "review": {
    "requireFinalVerdict": true,
    "maxFinalAttempts": 3
  },
  "handoff": {
    "path": ".spine/handoff.md",
    "autoWriteOn": [
      "session_start"
    ]
  },
  "metrics": {
    "enabled": true,
    "path": ".spine/run-metrics.jsonl"
  },
  "contract": {
    "mode": "required",
    "legacyTaskIdPrefixes": [
      "TP-"
    ]
  },
  "worktreeSetupHook": "",
  "referenceDocs": [],
  "standards": [],
  "neverLoad": []
}
